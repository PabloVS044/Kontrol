# Copia este archivo como .env.deploy (está en .gitignore) y rellena los valores.
# Uso: ./scripts/deploy.sh
# El script despliega la rama actual si ya existe en origin. También puedes forzar otra con:
# GIT_REF=main ./scripts/deploy.sh

# Conexión SSH a la VM
VM_IP=34.121.51.151
VM_USER=           # tu usuario en la VM (ej: pablo)
SSH_KEY=~/.ssh/id_rsa  # ruta a tu clave SSH privada

# Base de datos
POSTGRES_PASSWORD=jiP45qW05Vj00wnlvPAoQ
MONGODB_URI=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://34.121.51.151.nip.io/api/auth/google/callback

# Frontend
# Usa HTTPS real en producción si quieres que videollamadas/cámara funcionen en navegador.
FRONTEND_URL=https://34.121.51.151.nip.io
# Opcional: si no lo defines, deploy.sh lo deriva desde FRONTEND_URL
PUBLIC_HOST=34.121.51.151.nip.io

# Adjuntos
UPLOADTHING_TOKEN=

# Agente de IA (Kontrol AI) — opcional. Sin AGENT_API_KEY el agente queda
# deshabilitado. Vacíos = valores por defecto de backend/.env.example.
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_TEMPERATURE=
AGENT_MAX_TOKENS=
AGENT_MAX_STEPS=
AGENT_DISABLE_THINKING=

# Opcional: solo si quieres forzar URLs explícitas o TURN en el build del frontend
VITE_API_URL=
VITE_SOCKET_URL=
VITE_WEBRTC_ICE_SERVERS=

# Ambiente de pruebas (SCRUM-25) — opcional.
# Si TEST_DATABASE_URL está vacío, deploy.sh despliega solo producción,
# igual que hoy. Rellena esta sección para levantar backend-test/frontend-test
# junto al stack de siempre, en el mismo Caddy, bajo TEST_PUBLIC_HOST.
#
# TEST_DATABASE_URL debe ser la cadena del "Session pooler" de Supabase
# (Project Settings → Database → Connection string → Session pooler), no la
# conexión directa (suele ser IPv6-only) ni el Transaction pooler (puerto
# 6543, no apto para el pool de conexiones persistente del backend).
TEST_DATABASE_URL=
TEST_DATABASE_SSL=true
# DT-15 — la conexión TLS ahora verifica el certificado. Supabase firma con
# su propia CA: descárgala en Project Settings → Database → SSL Configuration
# y pégala aquí en una sola línea, con los saltos escapados como \n:
#   awk 'NF {printf "%s\\n", $0}' prod-ca-2021.crt
TEST_DATABASE_SSL_CA=

# Genera uno distinto al JWT_SECRET de producción: openssl rand -hex 32
TEST_JWT_SECRET=

TEST_FRONTEND_URL=https://test.34.121.51.151.nip.io
TEST_PUBLIC_HOST=test.34.121.51.151.nip.io
