PORT=3000

# PostgreSQL local (Docker Compose)
# When running via docker-compose, the host is "postgres" (service name)
# When running the backend directly without Docker, use "localhost"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kontrol

# Set to "true" only if connecting to a remote DB that requires SSL (e.g. Supabase)
DATABASE_SSL=false

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=8h

# Google OAuth
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Add http://localhost:3000/api/auth/google/callback to "Authorized redirect URIs"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend URL (used to redirect after OAuth callback)
FRONTEND_URL=http://localhost:5173

# MongoDB (for chat)
# When running via docker-compose, the host is "mongo" (service name)
MONGODB_URI=mongodb://mongo:27017/kontrol_chat

# Integrations — used to encrypt stored API keys and webhook URLs
# Must be a long random string. If omitted, falls back to JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=

# UploadThing (for chat file/image/audio uploads)
# Token format is a base64 encoded JSON credential from UploadThing
UPLOADTHING_TOKEN=

# Rate limiting (DT-13). All optional; the defaults below apply when unset.
# Set RATE_LIMIT_ENABLED=false only for load tests that must not be throttled.
RATE_LIMIT_ENABLED=true
# Requests per IP to /api/auth/* every 15 min
RATE_LIMIT_AUTH_MAX=100
# Login attempts per IP every 15 min (successful or not)
RATE_LIMIT_LOGIN_IP_MAX=30
# Failed login attempts per account every 15 min
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
# Requests per user per minute to the expensive endpoints from SCRUM-28
RATE_LIMIT_EXPENSIVE_MAX=60



# AI Agent (Kontrol AI)
# Optional override. If omitted, Kontrol uses https://model.clawstitch.com/v1
# and appends "/chat/completions" automatically.
AGENT_API_URL=
AGENT_API_KEY=
AGENT_MODEL=Qwen/Qwen3.6-27B-FP8
AGENT_TEMPERATURE=0.2
# Qwen 3.6 is a reasoning model — give it headroom for the thinking phase plus the JSON turn.
AGENT_MAX_TOKENS=4096
AGENT_MAX_STEPS=5
AGENT_DISABLE_THINKING=false
