{
  "name": "@control/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --dns-result-order=ipv4first --watch src/index.js",
    "start": "node --dns-result-order=ipv4first src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed:test": "node src/db/seed.js",
    "reset:test": "node src/db/reset.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.6"
  }
}
